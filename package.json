{
  "name": "open-city-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node tools/copy-decoders.mjs && node tools/textures/build.mjs --if-missing",
    "prebuild": "node tools/copy-decoders.mjs && node tools/textures/build.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "build:chunk": "node tools/build-chunk.mjs",
    "textures": "node tools/textures/build.mjs",
    "decoders": "node tools/copy-decoders.mjs",
    "shots": "node tools/preview/shot.mjs",
    "test": "node --test tools/textures/test/*.test.mjs",
    "textures:check": "node tools/textures/check.mjs",
    "docs:materials": "node tools/textures/docs.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^7.30.0",
    "@babylonjs/loaders": "^7.30.0"
  },
  "devDependencies": {
    "@babylonjs/ktx2decoder": "^7.54.3",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "zstddec": "^0.3.4"
  }
}

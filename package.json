{
  "name": "open-city-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "build:chunk": "node tools/build-chunk.mjs",
    "gen": "node tools/gen/index.mjs all",
    "gen:models": "node tools/gen/index.mjs models",
    "gen:chunks": "node tools/gen/index.mjs chunks",
    "predev": "node tools/gen/index.mjs all --if-missing",
    "prebuild": "node tools/gen/index.mjs all --if-missing"
  },
  "dependencies": {
    "@babylonjs/core": "^7.30.0",
    "@babylonjs/loaders": "^7.30.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "earcut": "^3.2.4",
    "gltfpack": "^1.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
